# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不要提交）
#
# 说明：
#   DB_TYPE 可选 sqlite / mysql / postgres，不设置时默认 sqlite。
#   SQLite 走的是 DATADIR（数据目录），不是 DB_DSN。
#   程序启动时用 godotenv 读取本文件；没有 .env 也能正常启动。

# ---- SQLite（默认） ----
DB_TYPE=sqlite
# SQLite 的数据目录，不设置时用 ./data/default
# DATADIR=./data/default

# ---- MySQL ----
# DB_TYPE=mysql
# DB_DSN="user:password@tcp(127.0.0.1:3306)/sealdice?charset=utf8mb4&parseTime=True&loc=Local"

# ---- PostgreSQL ----
# DB_TYPE=postgres
# DB_DSN="postgres://user:password@localhost:5432/sealdice?sslmode=disable"
