# ---- 以下为构造产物 / 本地文件，绝不入库 ----

# 前端构建产物：仓库里只保留占位页 static/frontend/index.html
# （真正的 UI 由 scripts/build-windows.ps1 或 Dockerfile 的 UI 阶段生成）
/static/frontend/*
!/static/frontend/index.html

# helpdoc-render 是独立的 Go module，便携二进制请自行构建，不要提交
helpdoc-render/helpdoc-render-*

